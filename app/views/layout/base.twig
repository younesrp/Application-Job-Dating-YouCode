<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Job Dating - Admin{% endblock %}</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {% block styles %}{% endblock %}
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="glass-card rounded-2xl shadow-2xl p-6 mb-6 text-white">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-3xl font-bold mb-2">
                        <i class="fas fa-user-graduate mr-3"></i>
                        Bienvenue, {{ user.prenom }} {{ user.nom }} !
                    </h1>
                    <p class="text-white/80">Votre espace apprenant YouCode</p>
                    <div class="mt-3 flex items-center text-sm">
                        <i class="fas fa-envelope mr-2"></i>
                        {{ user.email }}
                        <span class="ml-4 px-3 py-1 bg-blue-500/30 rounded-full text-xs">
                            <i class="fas fa-user mr-1"></i> Apprenant
                        </span>
                    </div>
                </div>
                <div class="mt-4 md:mt-0">
                    <a href="/logout" 
                       class="inline-flex items-center px-5 py-3 bg-red-500 hover:bg-red-600 text-white rounded-lg transition">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>

        <div class="flex-1 flex flex-col md:ml-64 transition-all duration-300">
            <header class="flex justify-between items-center py-4 px-6 bg-white shadow-sm h-16">
                <div class="flex items-center">
                    <button class="text-gray-500 focus:outline-none md:hidden">
                        <i class="fas fa-bars fa-lg"></i>
                    </button>
                    <h2 class="text-xl font-semibold text-gray-800 ml-4 md:ml-0">
                        {% block page_title %}Dashboard{% endblock %}
                    </h2>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold">A</div>
                        <span class="text-sm font-medium text-gray-700">Admin</span>
                    </div>
                </div>
                
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
                {% block body %}
                {% endblock %}
            </main>
        </div>
    </div>
    {% block scripts %}
    {% endblock %}
</body>
</html>