<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Job Dating - Admin{% endblock %}</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

    <div class="flex h-screen overflow-hidden">
        
        <aside class="w-64 bg-gray-900 text-white hidden md:flex flex-col shadow-xl fixed h-full z-10">
            <div class="h-16 flex items-center justify-center border-b border-gray-800">
                <h1 class="text-xl font-bold text-white tracking-wider">
                    <i class="fas fa-briefcase text-blue-500 mr-2"></i>YouCode
                </h1>
            </div>

            <nav class="flex-1 px-4 py-6 space-y-2">
                <a href="/admin/dashboard" class="flex items-center px-4 py-3 bg-gray-800 text-white rounded-lg transition-colors duration-200">
                    <i class="fas fa-home w-6"></i>
                    <span class="font-medium">Dashboard</span>
                </a>
                <a href="/admin/announcements" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-800 hover:text-white rounded-lg transition-colors duration-200">
                    <i class="fas fa-bullhorn w-6"></i>
                    <span>Annonces</span>
                </a>
                <a href="/admin/companies" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-800 hover:text-white rounded-lg transition-colors duration-200">
                    <i class="fas fa-building w-6"></i>
                    <span>Entreprises</span>
                </a>
                <a href="/admin/students" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-800 hover:text-white rounded-lg transition-colors duration-200">
                    <i class="fas fa-users w-6"></i>
                    <span>Apprenants</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-800">
                <a href="/logout" class="flex items-center px-4 py-2 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors duration-200 w-full justify-center">
                    <i class="fas fa-sign-out-alt mr-2"></i> Déconnexion
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col md:ml-64 transition-all duration-300">
            <header class="flex justify-between items-center py-4 px-6 bg-white shadow-sm h-16">
                <div class="flex items-center">
                    <button class="text-gray-500 focus:outline-none md:hidden">
                        <i class="fas fa-bars fa-lg"></i>
                    </button>
                    <h2 class="text-xl font-semibold text-gray-800 ml-4 md:ml-0">
                        {% block page_title %}Dashboard{% endblock %}
                    </h2>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold">A</div>
                        <span class="text-sm font-medium text-gray-700">Admin</span>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
                {% block body %}
                {% endblock %}
            </main>
        </div>
    </div>

</body>
</html>