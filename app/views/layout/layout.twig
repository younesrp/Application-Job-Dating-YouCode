{% extends "layout/base.twig" %}

{% block content %}
<div class="min-h-screen bg-gray-100">
    <!-- Navigation -->
    <nav class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-xl font-semibold">Job Dating - Espace Apprenant</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-700">Bienvenue, {{ user.name }}</span>
                    <a href="/logout" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600">Déconnexion</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenu principal -->
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
                
                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Offres Recommandées</p>
                        <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.recommended_jobs }}</h3>
                    </div>
                    <div class="p-3 bg-blue-50 rounded-lg text-blue-600">
                        <i class="fas fa-star fa-lg"></i>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Candidatures Envoyées</p>
                        <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.applications_sent }}</h3>
                    </div>
                    <div class="p-3 bg-indigo-50 rounded-lg text-indigo-600">
                        <i class="fas fa-paper-plane fa-lg"></i>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Entreprises Suivies</p>
                        <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.followed_companies }}</h3>
                    </div>
                    <div class="p-3 bg-emerald-50 rounded-lg text-emerald-600">
                        <i class="fas fa-heart fa-lg"></i>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Entretiens Planifiés</p>
                        <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.interviews_scheduled }}</h3>
                    </div>
                    <div class="p-3 bg-amber-50 rounded-lg text-amber-600">
                        <i class="fas fa-calendar-check fa-lg"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <h3 class="font-bold text-slate-700">Dernières Offres d'Emploi</h3>
                    <a href="/jobs" class="text-sm text-blue-600 hover:text-blue-800 font-medium">Tout voir &rarr;</a>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-semibold border-b border-gray-100">
                                <th class="px-6 py-4">Poste</th>
                                <th class="px-6 py-4">Entreprise</th>
                                <th class="px-6 py-4">Type de contrat</th>
                                <th class="px-6 py-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            {% for job in recent_jobs %}
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-6 py-4 font-medium text-slate-700">
                                    {{ job.title }}
                                    <br>
                                    <span class="text-xs text-gray-400 font-normal">Publié le: {{ job.created_at | date("d M Y") }}</span>
                                </td>
                                <td class="px-6 py-4 text-gray-500">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-building text-gray-400"></i>
                                        {{ job.company_name }}
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 border border-blue-200">
                                        {{ job.contract_type }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="/jobs/{{ job.id }}" class="text-slate-400 hover:text-blue-600 p-2 transition-colors" title="Voir">
                                        <i class="far fa-eye"></i>
                                    </a>
                                    <a href="/jobs/{{ job.id }}/apply" class="text-slate-400 hover:text-green-500 p-2 transition-colors" title="Postuler">
                                        <i class="fas fa-paper-plane"></i>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-8 text-gray-400 italic">
                                    Aucune offre d'emploi disponible pour le moment.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                        <h3 class="font-bold text-slate-700">Mes Candidatures</h3>
                    </div>
                    <div class="p-6">
                        {% for application in recent_applications %}
                        <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100 last:border-0 last:mb-0 last:pb-0">
                            <div>
                                <h4 class="font-medium text-slate-700">{{ application.job_title }}</h4>
                                <p class="text-sm text-gray-500">{{ application.company_name }} - {{ application.created_at | date("d M Y") }}</p>
                            </div>
                            <span class="px-3 py-1 rounded-full text-xs font-semibold 
                                {% if application.status == 'En attente' %}bg-amber-100 text-amber-700 border border-amber-200
                                {% elseif application.status == 'Accepté' %}bg-green-100 text-green-700 border border-green-200
                                {% else %}bg-red-100 text-red-700 border border-red-200{% endif %}">
                                {{ application.status }}
                            </span>
                        </div>
                        {% else %}
                        <p class="text-center text-gray-400 italic">Vous n'avez pas encore postulé à des offres.</p>
                        {% endfor %}
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                        <h3 class="font-bold text-slate-700">Événements à Venir</h3>
                    </div>
                    <div class="p-6">
                        {% for event in upcoming_events %}
                        <div class="flex items-start mb-4 pb-4 border-b border-gray-100 last:border-0 last:mb-0 last:pb-0">
                            <div class="p-2 bg-blue-50 rounded-lg text-blue-600 mr-4">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-medium text-slate-700">{{ event.title }}</h4>
                                <p class="text-sm text-gray-500">{{ event.date | date("d M Y à H:i") }}</p>
                                <p class="text-sm text-gray-600 mt-1">{{ event.description }}</p>
                            </div>
                        </div>
                        {% else %}
                        <p class="text-center text-gray-400 italic">Aucun événement prévu pour le moment.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
