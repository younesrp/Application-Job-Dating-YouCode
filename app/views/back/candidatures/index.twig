{% extends "back/layout.twig" %}

{% block title %}Gestion des Candidatures{% endblock %}

{% block content %}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-800 mb-2">
        <i class="fas fa-file-contract mr-2 text-blue-600"></i>
        Gestion des Candidatures
    </h1>
    <p class="text-slate-600">Consultez et gérez toutes les candidatures des apprenants</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg p-4 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase">Total Candidatures</p>
                <p class="text-2xl font-bold text-slate-800 mt-1">{{ stats.total }}</p>
            </div>
            <i class="fas fa-file-contract text-3xl text-blue-500 opacity-20"></i>
        </div>
    </div>

    <div class="bg-white rounded-lg p-4 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase">En Attente</p>
                <p class="text-2xl font-bold text-yellow-600 mt-1">{{ stats.en_attente }}</p>
            </div>
            <i class="fas fa-hourglass-half text-3xl text-yellow-500 opacity-20"></i>
        </div>
    </div>

    <div class="bg-white rounded-lg p-4 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase">Validées</p>
                <p class="text-2xl font-bold text-green-600 mt-1">{{ stats.validee }}</p>
            </div>
            <i class="fas fa-check-circle text-3xl text-green-500 opacity-20"></i>
        </div>
    </div>

    <div class="bg-white rounded-lg p-4 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase">Refusées</p>
                <p class="text-2xl font-bold text-red-600 mt-1">{{ stats.refusee }}</p>
            </div>
            <i class="fas fa-times-circle text-3xl text-red-500 opacity-20"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-lg border border-slate-200 shadow-sm">
    {% if candidatures %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Apprenant</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Offre</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Entreprise</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Statut</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for candidature in candidatures %}
                        <tr class="border-b border-slate-200 hover:bg-slate-50 transition">
                            <td class="px-6 py-4">
                                <div class="font-semibold text-slate-800">
                                    {{ candidature.apprenant_prenom }} {{ candidature.apprenant_nom }}
                                </div>
                                <div class="text-xs text-slate-500">
                                    ID: {{ candidature.apprenant_id }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-800">{{ candidature.annonce_titre }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-slate-700">{{ candidature.entreprise_nom }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-slate-600">
                                    {{ candidature.date_candidature|date('d/m/Y H:i') }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold inline-block
                                    {% if candidature.statut == 'validee' %}
                                        bg-green-100 text-green-700
                                    {% elseif candidature.statut == 'refusee' %}
                                        bg-red-100 text-red-700
                                    {% else %}
                                        bg-yellow-100 text-yellow-700
                                    {% endif %}">
                                    {{ candidature.statut|capitalize }}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <button onclick="viewCandidature({{ candidature.id }})" 
                                    class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-medium transition shadow-sm border border-blue-700">
                                    <i class="fas fa-eye mr-1"></i>Voir
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="px-6 py-12 text-center">
            <i class="fas fa-inbox text-5xl text-slate-300 mb-4 block"></i>
            <p class="text-slate-600 font-medium">Aucune candidature</p>
            <p class="text-slate-500 text-sm">Les candidatures apparaîtront ici</p>
        </div>
    {% endif %}
</div>

<div id="modalCandidatureDetail" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/75 backdrop-blur-sm transition-opacity"></div>

    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-5xl">
            
            <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 bg-white">
                <div>
                    <h3 class="text-xl font-bold text-gray-900" id="detailTitle">Détails de la candidature</h3>
                    <p class="text-sm text-gray-500 mt-1">
                        Reçue le <span id="detailDate" class="font-medium text-gray-700"></span>
                    </p>
                </div>
                <button type="button" onclick="closeDetail()" class="rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 transition focus:outline-none">
                    <span class="sr-only">Fermer</span>
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div class="px-6 py-6 bg-gray-50/50">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    
                    <div class="lg:col-span-1 space-y-6">
                        <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 to-purple-500"></div>
                            <div class="flex flex-col items-center text-center mb-6">
                                <div class="h-20 w-20 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 mb-3 border-2 border-indigo-100">
                                    <i class="fas fa-user-graduate text-3xl"></i>
                                </div>
                                <h4 class="text-lg font-bold text-gray-900" id="detailNom"></h4>
                                <span class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mt-2" id="detailPromotion"></span>
                            </div>
                            
                            <div class="space-y-4 border-t border-gray-100 pt-4">
                                <div class="flex items-start">
                                    <i class="fas fa-envelope mt-1 w-5 text-gray-400 text-sm"></i>
                                    <div class="ml-3">
                                        <p class="text-xs text-gray-500 uppercase font-semibold">Email</p>
                                        <p class="text-sm text-gray-900 break-all" id="detailEmail"></p>
                                    </div>
                                </div>
                                <div class="flex items-start">
                                    <i class="fas fa-phone mt-1 w-5 text-gray-400 text-sm"></i>
                                    <div class="ml-3">
                                        <p class="text-xs text-gray-500 uppercase font-semibold">Téléphone</p>
                                        <p class="text-sm text-gray-900" id="detailTelephone"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-2 space-y-6">
                        
                        <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4 flex items-center">
                                <i class="fas fa-briefcase mr-2 text-emerald-500"></i> Poste visé
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <span class="text-xs text-gray-500 block mb-1">Intitulé du poste</span>
                                    <span class="text-lg font-semibold text-gray-900" id="detailTitreOffre"></span>
                                </div>
                                <div>
                                    <span class="text-xs text-gray-500 block mb-1">Entreprise</span>
                                    <span class="text-base font-medium text-gray-900 flex items-center">
                                        <i class="far fa-building mr-2 text-gray-400"></i>
                                        <span id="detailEntreprise"></span>
                                    </span>
                                </div>
                                <div>
                                    <span class="text-xs text-gray-500 block mb-1">Type de contrat</span>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-blue-50 text-blue-700" id="detailContrat">
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm flex-grow">
                            <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4 flex items-center">
                                <i class="fas fa-quote-left mr-2 text-purple-500"></i> Lettre de motivation
                            </h4>
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <p class="text-gray-700 whitespace-pre-wrap text-sm leading-relaxed" id="detailMessage"></p>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-2">
                            <button onclick="updateStatus('refusee')" class="px-4 py-2 bg-white border border-red-200 text-red-600 hover:bg-red-50 rounded-lg font-medium transition shadow-sm">
                                <i class="fas fa-times mr-2"></i>Refuser
                            </button>
                            <button onclick="updateStatus('en_attente')" class="px-4 py-2 bg-white border border-yellow-200 text-yellow-600 hover:bg-yellow-50 rounded-lg font-medium transition shadow-sm">
                                <i class="fas fa-clock mr-2"></i>En attente
                            </button>
                            <button onclick="updateStatus('validee')" class="px-6 py-2 bg-gradient-to-r from-emerald-500 to-teal-600 text-white hover:from-emerald-600 hover:to-teal-700 rounded-lg font-medium transition shadow-md">
                                <i class="fas fa-check mr-2"></i>Valider la candidature
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentCandidatureId = null;
let candidaturesData = {
    {% for candidature in candidatures %}
        {{ candidature.id }}: {
            id: {{ candidature.id }},
            apprenant_nom: "{{ candidature.apprenant_nom }}",
            apprenant_prenom: "{{ candidature.apprenant_prenom }}",
            apprenant_email: "{{ candidature.apprenant_email }}",
            apprenant_telephone: "{{ candidature.apprenant_telephone }}",
            promotion: "{{ candidature.promotion }}",
            annonce_titre: "{{ candidature.annonce_titre }}",
            entreprise_nom: "{{ candidature.entreprise_nom }}",
            type_contrat: "{{ candidature.type_contrat }}",
            message: "{{ candidature.message|escape('js') }}",
            statut: "{{ candidature.statut }}",
            date_candidature: "{{ candidature.date_candidature|date('d/m/Y H:i') }}"
        },
    {% endfor %}
};

function viewCandidature(id) {
    const data = candidaturesData[id];
    if (!data) return;

    currentCandidatureId = id;

    // Remplir les infos
    // document.getElementById('detailTitle').textContent = data.annonce_titre + ' - ' + data.apprenant_prenom;
    document.getElementById('detailNom').textContent = data.apprenant_prenom + ' ' + data.apprenant_nom;
    document.getElementById('detailEmail').textContent = data.apprenant_email;
    document.getElementById('detailTelephone').textContent = data.apprenant_telephone || 'Non fourni';
    document.getElementById('detailPromotion').textContent = data.promotion;
    document.getElementById('detailTitreOffre').textContent = data.annonce_titre;
    document.getElementById('detailEntreprise').textContent = data.entreprise_nom;
    document.getElementById('detailContrat').textContent = data.type_contrat;
    document.getElementById('detailMessage').textContent = data.message;
    document.getElementById('detailDate').textContent = data.date_candidature;

    document.getElementById('modalCandidatureDetail').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function closeDetail() {
    document.getElementById('modalCandidatureDetail').classList.add('hidden');
    document.body.style.overflow = 'auto';
}

function updateStatus(status) {
    if (!currentCandidatureId) {
        console.error('Pas de candidature sélectionnée');
        return;
    }
    
    const url = `/admin/candidatures/${currentCandidatureId}/status`;
    const payload = { statut: status };
    
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(payload)
    })
    .then(response => {
        if (!response.ok && response.status !== 200) {
            return response.text().then(text => { throw new Error(text) });
        }
        return response.text();
    })
    .then(text => {
        try {
            const data = JSON.parse(text);
            if (data.success) {
                // alert('Statut mis à jour avec succès'); 
                location.reload();
            } else {
                alert('Erreur: ' + (data.message || 'Impossible de mettre à jour'));
            }
        } catch (e) {
            location.reload(); // Au cas où le JSON est mal formé mais l'action a marché
        }
    })
    .catch(err => {
        console.error('Erreur fetch:', err);
        alert('Une erreur est survenue.');
    });
}

// Fermer le modal en cliquant dehors
document.getElementById('modalCandidatureDetail').addEventListener('click', function(e) {
    // On ferme seulement si on clique sur le fond gris (pas sur le contenu)
    // Le premier div enfant est le backdrop, donc on vérifie si on clique sur le parent flex
    if (e.target.classList.contains('flex') && e.target.classList.contains('items-center')) {
        closeDetail();
    }
});

// Fermer avec Échap
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDetail();
});
</script>

{% endblock %}