{% extends "back/layout.twig" %}

{% block title %}Gestion des Candidatures{% endblock %}

{% block content %}

    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Gestion des Candidatures</h2>
            <p class="text-slate-500">Gérez les postulations des étudiants (Validation / Refus).</p>
        </div>
        <div class="bg-purple-50 text-purple-700 px-4 py-2 rounded-lg text-sm font-medium border border-purple-100 flex items-center gap-2">
            <i class="fas fa-gavel"></i>
            <span>Espace Décision</span>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold">
                    <tr>
                        <th class="px-6 py-4">Candidat</th>
                        <th class="px-6 py-4">Offre / Entreprise</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4 text-center">Décision</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 text-sm">
                    {% for candidature in candidatures %}
                    <tr class="hover:bg-slate-50 transition group">
                        
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 font-bold shadow-sm">
                                    {{ candidature.apprenant_nom|first|upper }}
                                </div>
                                <div>
                                    <p class="font-bold text-slate-700">{{ candidature.apprenant_nom|upper }} {{ candidature.apprenant_prenom|capitalize }}</p>
                                    <p class="text-xs text-slate-400">Candidat</p>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4">
                            <p class="font-bold text-slate-700">{{ candidature.annonce_titre }}</p>
                            <div class="flex items-center gap-2 mt-1">
                                <i class="far fa-building text-xs text-slate-400"></i>
                                <span class="text-xs text-slate-500">{{ candidature.entreprise_nom }}</span>
                            </div>
                        </td>

                        <td class="px-6 py-4 text-slate-500">
                            <div class="flex items-center gap-2">
                                <i class="far fa-calendar-alt text-xs opacity-50"></i>
                                {{ candidature.date_candidature | date("d/m/Y") }}
                            </div>
                        </td>

                        <td class="px-6 py-4 text-center">
                            
                            {% if candidature.statut == 'en_attente' %}
                                <div class="flex items-center justify-center gap-2">
                                    
                                    <form action="/admin/candidatures/update/{{ candidature.id }}" method="POST">
                                        <input type="hidden" name="statut" value="validee">
                                        <button type="submit" class="bg-green-100 hover:bg-green-500 hover:text-white text-green-700 h-8 w-8 rounded-lg transition flex items-center justify-center shadow-sm" title="Valider">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>

                                    <form action="/admin/candidatures/update/{{ candidature.id }}" method="POST">
                                        <input type="hidden" name="statut" value="refusee">
                                        <button type="submit" class="bg-red-100 hover:bg-red-500 hover:text-white text-red-700 h-8 w-8 rounded-lg transition flex items-center justify-center shadow-sm" title="Refuser" onclick="return confirm('Êtes-vous sûr de vouloir refuser ce candidat ?');">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </div>

                            {% else %}
                                <div class="flex items-center justify-center gap-3">
                                    
                                    {% if candidature.statut == 'validee' %}
                                        <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 px-3 py-1 rounded-full text-xs font-bold border border-green-200">
                                            Validée
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 bg-red-50 text-red-700 px-3 py-1 rounded-full text-xs font-bold border border-red-200">
                                            Refusée
                                        </span>
                                    {% endif %}

                                    <form action="/admin/candidatures/update/{{ candidature.id }}" method="POST">
                                        <input type="hidden" name="statut" value="en_attente">
                                        <button type="submit" class="text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 p-1.5 rounded-full transition" title="Annuler et corriger (Retour à En attente)">
                                            <i class="fas fa-undo-alt text-sm"></i>
                                        </button>
                                    </form>

                                </div>
                            {% endif %}

                        </td>

                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-400 italic bg-slate-50/50">
                            <i class="far fa-folder-open text-3xl mb-3 block opacity-30"></i>
                            Aucune candidature reçue pour le moment.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}