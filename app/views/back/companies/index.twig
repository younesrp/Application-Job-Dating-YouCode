{% extends "layout/base.twig" %} 

{% block title %}Ajouter une Entreprise{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/assets/css/style.css">
{% endblock %}

{% block content %}
<div class="container">
    <h1><i class="fas fa-building"></i> Gestion des Entreprises</h1>
    
    <button type="button" class="add-btn" id="addEntrepriseBtn">
        <i class="fas fa-plus-circle"></i> Ajouter une Entreprise
    </button>
    
    <div class="hidden-section" id="entrepriseSection">
        <h2 class="form-title"><i class="fas fa-file-alt"></i> Informations de l'Entreprise</h2>
        
        {# 1. لاحظ إضافة enctype و method #}
        <form id="entrepriseForm" action="/Company" method="POST" enctype="multipart/form-data">
            
            {# 2. تصحيح اسم التوكن #}
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <div class="form-grid">
                <div class="form-group">
                    <label for="nom"><i class="fas fa-signature"></i> Nom de l'entreprise <span class="required">*</span></label>
                    <input type="text" id="nom" name="Nom" placeholder="Entrez le nom">
                </div>
                
                <div class="form-group">
                    <label for="secteur"><i class="fas fa-industry"></i> Secteur d'activité <span class="required">*</span></label>
                    <select id="secteur" name="Secteur">
                        <option value="">Sélectionnez un secteur</option>
                        <option value="informatique">Informatique & Technologies</option>
                        <option value="commerce">Commerce & Distribution</option>
                        <option value="industrie">Industrie & Production</option>
                        <option value="services">Services & Consulting</option>
                        <option value="banque">Banque & Finance</option>
                        <option value="sante">Santé & Médical</option>
                        <option value="education">Éducation & Formation</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="ville"><i class="fas fa-city"></i> Ville <span class="required">*</span></label>
                    <input type="text" id="ville" name="Ville" placeholder="Ville">
                </div>
                
                <div class="form-group">
                    <label for="email"><i class="fas fa-envelope"></i> Email <span class="required">*</span></label>
                    <input type="email" id="email" name="email" placeholder="Email">
                </div>
                
                <div class="form-group">
                    <label for="telephone"><i class="fas fa-phone"></i> Téléphone <span class="required">*</span></label>
                    <input type="tel" id="telephone" name="telephone" placeholder="+212...">
                </div>
                
                <div class="form-group logo-upload">
                    <label for="logo"><i class="fas fa-image"></i> Logo de l'entreprise</label>
                    <div class="upload-area" id="logoUpload">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <p class="upload-text">Cliquez pour télécharger le logo</p>
                        {# name="logo" ضروري لاستقبال الملف #}
                        <input type="file" id="logo" name="logo" accept="image/*">
                    </div>
                </div>
                
                <div class="form-buttons">
                    <button type="submit" class="submit-btn">
                        <i class="fas fa-check"></i> Enregistrer
                    </button>
                    <button type="button" class="cancel-btn" id="cancelBtn">
                        <i class="fas fa-times"></i> Annuler
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/script.js"></script>
{% endblock %}