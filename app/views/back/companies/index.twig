{% extends "back/layout.twig" %}

{% block title %}Gestion des Entreprises{% endblock %}

{% block content %}

    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Entreprises</h2>
            <p class="text-slate-500">Gérez vos partenaires et employeurs.</p>
        </div>
        <a href="/admin/companies/create" class="bg-indigo-600 text-white px-6 py-3 rounded-xl shadow-lg hover:bg-indigo-700 transition">
            <i class="fas fa-plus mr-2"></i> Ajouter une entreprise
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase">
                <tr>
                    <th class="px-6 py-4">Entreprise</th>
                    <th class="px-6 py-4">Secteur / Ville</th>
                    <th class="px-6 py-4">Contact</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
                
                {% for company in companies %}
                <tr class="hover:bg-slate-50 transition">
                    
                   <td class="px-6 py-4 font-bold text-slate-700">
                    <div class="flex items-center gap-3">
                        
                        <img 
src="http://localhost:8081/Application-Job-Dating-YouCode/public/assets/logos/{{ company.logo }}"     
                   alt="{{ company.nom }}" 
                            class="h-12 w-12 rounded-lg object-cover border border-slate-200 shadow-sm bg-white"
                            
                            السحر هنا: إلا مالقاش التصويرة، كيبدل المصدر لرابط الحروف أوتوماتيكياً
                            onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name={{ company.nom }}&background=random&color=fff&size=128';"
                        >

                        <span class="text-base">{{ company.nom }}</span>
                    </div>
                </td>

                    <td class="px-6 py-4">
                        <p class="font-medium text-slate-800">{{ company.secteur }}</p>
                        <p class="text-xs text-slate-400">{{ company.ville }}</p>
                    </td>

                    <td class="px-6 py-4 text-slate-500">
                        <p>{{ company.email }}</p>
                        <p class="text-xs">{{ company.telephone }}</p>
                    </td>

                    <td class="px-6 py-4 text-right">
                        <a href="/admin/companies/edit/{{ company.id }}" class="text-indigo-600 hover:bg-indigo-50 p-2 rounded"><i class="far fa-edit"></i></a>
                        <a href="/admin/companies/delete/{{ company.id }}" class="text-red-600 hover:bg-red-50 p-2 rounded" onclick="return confirm('Supprimer cette entreprise ?')"><i class="far fa-trash-alt"></i></a>
                    </td>
                </tr>

                {% else %}
                <tr>
                    <td colspan="4" class="text-center py-8 text-slate-400 italic">
                        Aucune entreprise trouvée.
                    </td>
                </tr>
                {% endfor %}

            </tbody>
        </table>
    </div>

{% endblock %}