{% extends "back/layout.twig" %}

{% block title %}Modifier l'annonce{% endblock %}

{% block content %}

    <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-sm border border-slate-100 mt-6">
        
        <div class="mb-6 border-b border-slate-100 pb-4">
            <h2 class="text-2xl font-bold text-slate-800">Modifier l'annonce</h2>
            <p class="text-slate-500 text-sm">Mise à jour de : <span class="font-semibold text-indigo-600">{{ annonce.titre }}</span></p>
        </div>

        <form action="/admin/annonces/update/{{ annonce.id }}" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Titre du poste</label>
                <input type="text" name="titre" required 
                       value="{{ annonce.titre }}" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 outline-none transition font-medium text-slate-700">
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Entreprise</label>
                <div class="relative">
                    <select name="entreprise_id" required 
                            class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 outline-none bg-white appearance-none cursor-pointer">
                        
                        {% for company in companies %}
                            <option value="{{ company.id }}" 
                                {% if company.id == annonce.entreprise_id %} selected {% endif %}>
                                {{ company.nom }}
                            </option>
                        {% endfor %}

                    </select>
                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                        <i class="fas fa-chevron-down text-xs"></i>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Statut de l'annonce</label>
                <div class="relative">
                    <select name="status" required 
                            class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 outline-none bg-white appearance-none cursor-pointer">
                        
                        <option value="0" class="text-green-600 font-bold" {% if annonce.is_deleted == 0 %} selected {% endif %}>
                            🟢 Active (Visible)
                        </option>

                        <option value="1" class="text-red-500 font-bold" {% if annonce.is_deleted == 1 %} selected {% endif %}>
                            🔴 Archivée (Cachée)
                        </option>

                    </select>
                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                        <i class="fas fa-chevron-down text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-slate-400 mt-2">Si vous sélectionnez "Archivée", l'annonce ne sera plus visible pour les candidats.</p>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Description</label>
                <textarea name="description" rows="6" required
                          class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 outline-none transition text-slate-600 leading-relaxed">{{ annonce.description }}</textarea>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-slate-100 mt-6">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl shadow-lg shadow-indigo-200 transition font-medium flex items-center gap-2">
                    <i class="fas fa-save"></i> Sauvegarder
                </button>
                <a href="/admin/annonces" class="text-slate-500 hover:text-slate-700 font-medium px-4 transition">Annuler</a>
            </div>

        </form>
    </div>

{% endblock %}