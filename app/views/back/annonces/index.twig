{% extends "back/layout.twig" %}

{% block title %}Gestion des Annonces{% endblock %}

{% block content %}

    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Gestion des Annonces</h2>
            <p class="text-slate-500">Liste complète des offres d'emploi.</p>
        </div>
        
        <a href="/admin/annonces/create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-indigo-200 transition flex items-center gap-2">
            <i class="fas fa-plus"></i> Nouvelle Annonce
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold">
                    <tr>
                        <th class="px-6 py-4">Titre / Description</th>
                        <th class="px-6 py-4">Entreprise</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 text-sm">
                    {% for annonce in annonces %}
                    <tr class="hover:bg-slate-50 transition group">
                        
                        <td class="px-6 py-4">
                            <p class="font-bold text-slate-700 text-base">{{ annonce.titre }}</p>
                            <p class="text-slate-400 text-xs mt-1 truncate w-48">{{ annonce.description }}</p>
                        </td>

                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <div class="h-8 w-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                    <i class="fas fa-building"></i>
                                </div>
                                <span class="font-medium text-slate-600">
                                    {{ annonce.entreprise_nom|default('Non spécifié') }}
                                </span>
                            </div>
                        </td>

                        <td class="px-6 py-4 text-slate-500">
                            {{ annonce.date_creation | date("d M, Y") }}
                        </td>

                        <td class="px-6 py-4 text-center">
                            {% if annonce.is_deleted == 0 %}
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700 border border-green-200">
                                    Active
                                </span>
                            {% else %}
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-500 border border-gray-200">
                                    Archivée
                                </span>
                            {% endif %}
                        </td>

                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                
                                <a href="/admin/annonces/edit/{{ annonce.id }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Modifier">
                                    <i class="far fa-edit"></i>
                                </a>

                                <a href="/admin/annonces/delete/{{ annonce.id }}" 
                                   class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" 
                                   title="Archiver"
                                   onclick="return confirm('Êtes-vous sûr de vouloir archiver cette annonce ?');">
                                    <i class="far fa-trash-alt"></i>
                                </a>

                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-slate-400 italic">
                            Aucune annonce trouvée. <br>
                            <span class="text-xs">Cliquez sur "Nouvelle Annonce" pour commencer.</span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}