{# 1. كنورثو الهيكل من الملف للي الفوق #}
{% extends "back/layout.twig" %}

{# 2. كنبدلو العنوان ديال الصفحة #}
{% block title %}Gestion des Annonces{% endblock %}

{# 3. كنحطو المحتوى ديالنا وسط البلوك #}
{% block content %}

    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Liste des Annonces</h2>
            <p class="text-slate-500">Gérez vos offres d'emploi.</p>
        </div>
        <a href="/admin/annonces/create" class="bg-indigo-600 text-white px-6 py-3 rounded-xl shadow-lg hover:bg-indigo-700 transition">
            <i class="fas fa-plus mr-2"></i> Créer
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase">
                <tr>
                    <th class="px-6 py-4">Titre</th>
                    <th class="px-6 py-4">Entreprise</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
                {% for annonce in annonces %}
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 font-bold text-slate-700">{{ annonce.titre }}</td>
                    <td class="px-6 py-4">{{ annonce.entreprise_nom|default('Non spécifié') }}</td>
                    <td class="px-6 py-4">
                        {% if annonce.is_deleted == 0 %}
                            <span class="text-green-600 bg-green-100 px-2 py-1 rounded text-xs font-bold">Active</span>
                        {% else %}
                            <span class="text-red-600 bg-red-100 px-2 py-1 rounded text-xs font-bold">Archivée</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right flex justify-end gap-2">
                        <a href="/admin/annonces/edit/{{ annonce.id }}" class="text-indigo-600 hover:bg-indigo-50 p-2 rounded"><i class="far fa-edit"></i></a>
                        <a href="/admin/annonces/delete/{{ annonce.id }}" class="text-red-600 hover:bg-red-50 p-2 rounded" onclick="return confirm('Confirmer ?')"><i class="far fa-trash-alt"></i></a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}