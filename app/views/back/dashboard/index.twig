{# 1. كنورثو "الدار" (Layout) #}
{% extends "back/layout.twig" %}

{# 2. عنوان الصفحة #}
{% block title %}Dashboard - Vue d'ensemble{% endblock %}

{# 3. المحتوى المتغير (فقط البطاقات والجدول) #}
{% block content %}

    <div class="relative w-full bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-8 mb-10 text-white shadow-xl overflow-hidden">
        <div class="relative z-10">
            <h2 class="text-3xl font-bold mb-2">Bonjour, Admin! 👋</h2>
            <p class="text-indigo-100">Voici ce qui se passe sur votre plateforme aujourd'hui.</p>
        </div>
        <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
        <div class="absolute bottom-0 right-20 -mb-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Offres Actives</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">{{ stats.active_annonces }}</h3>
                </div>
                <div class="p-3 bg-blue-50 rounded-xl text-blue-600">
                    <i class="fas fa-briefcase text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-green-500 mt-4 font-medium flex items-center">
                <i class="fas fa-arrow-up mr-1"></i> En ligne
            </p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Entreprises</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">{{ stats.entreprises }}</h3>
                </div>
                <div class="p-3 bg-purple-50 rounded-xl text-purple-600">
                    <i class="fas fa-building text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-4 font-medium">Partenaires inscrits</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Étudiants</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">{{ stats.students }}</h3>
                </div>
                <div class="p-3 bg-pink-50 rounded-xl text-pink-600">
                    <i class="fas fa-users text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-4 font-medium">Candidats potentiels</p>
        </div>

         <div class="bg-slate-800 rounded-2xl p-6 shadow-lg text-white hover:shadow-xl transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Archives</p>
                    <h3 class="text-3xl font-bold mt-2">{{ stats.archived_annonces }}</h3>
                </div>
                <div class="p-3 bg-slate-700 rounded-xl text-slate-300">
                    <i class="fas fa-archive text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-4 font-medium">Offres expirées</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-bold text-slate-800">Dernières Annonces publiées</h3>
            <a href="/admin/annonces" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">Voir tout</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase">
                    <tr>
                        <th class="px-6 py-4">Titre</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    {% for ad in recent_ads %}
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4">
                            <span class="font-bold text-slate-700 block">{{ ad.titre }}</span>
                            <span class="text-xs text-slate-400">{{ ad.entreprise_nom|default('Entreprise inconnue') }}</span>
                        </td>
                        <td class="px-6 py-4 text-slate-500">{{ ad.date_creation | date("d/m/Y") }}</td>
                        <td class="px-6 py-4 text-right">
                            <a href="/admin/annonces/edit/{{ ad.id }}" class="text-indigo-600 hover:bg-indigo-50 px-3 py-1 rounded-lg transition font-medium">
                                Gérer
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="3" class="px-6 py-8 text-center text-slate-400">
                            Aucune activité récente.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}