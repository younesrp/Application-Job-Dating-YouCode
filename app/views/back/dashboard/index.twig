{% extends "back/layout.twig" %}

{% block page_title %}Vue d'ensemble{% endblock %}

{% block content %}
    
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
        
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Annonces Actives</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.active_annonces }}</h3>
            </div>
            <div class="p-3 bg-blue-50 rounded-lg text-blue-600">
                <i class="fas fa-briefcase fa-lg"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Entreprises</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.entreprises }}</h3>
            </div>
            <div class="p-3 bg-indigo-50 rounded-lg text-indigo-600">
                <i class="fas fa-building fa-lg"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Étudiants Inscrits</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.students }}</h3>
            </div>
            <div class="p-3 bg-emerald-50 rounded-lg text-emerald-600">
                <i class="fas fa-users fa-lg"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Archives</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1">{{ stats.archived_annonces }}</h3>
            </div>
            <div class="p-3 bg-gray-100 rounded-lg text-gray-600">
                <i class="fas fa-archive fa-lg"></i>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <h3 class="font-bold text-slate-700">Dernières Annonces publiées</h3>
            <a href="/admin/annonces" class="text-sm text-blue-600 hover:text-blue-800 font-medium">Tout voir &rarr;</a>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-semibold border-b border-gray-100">
                        <th class="px-6 py-4">Titre de l'annonce</th>
                        <th class="px-6 py-4">Date de publication</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    {% for ad in recent_ads %}
                    <tr class="hover:bg-gray-50/80 transition-colors group">
                        <td class="px-6 py-4 font-medium text-slate-700">
                            {{ ad.titre }}
                            <br>
                            <span class="text-xs text-gray-400 font-normal">ID: #{{ ad.id }}</span>
                        </td>
                        <td class="px-6 py-4 text-gray-500">
                            <div class="flex items-center gap-2">
                                <i class="far fa-calendar-alt text-gray-400"></i>
                                {{ ad.date_creation | date("d M Y") }}
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700 border border-green-200">
                                Actif
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="#" class="text-slate-400 hover:text-blue-600 p-2 transition-colors" title="Voir">
                                <i class="far fa-eye"></i>
                            </a>
                            <a href="#" class="text-slate-400 hover:text-red-500 p-2 transition-colors" title="Supprimer">
                                <i class="far fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-8 text-gray-400 italic">
                            Aucune annonce trouvée pour le moment.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}