{% extends "back/layout.twig" %}

{% block title %}Gestion des Apprenants{% endblock %}

{% block content %}

    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Liste des Apprenants</h2>
            <p class="text-slate-500">Liste complète des étudiants inscrits.</p>
        </div>
        <div class="bg-indigo-50 text-indigo-700 px-4 py-2 rounded-lg text-sm font-medium border border-indigo-100">
            <i class="fas fa-user-graduate mr-2"></i> Espace Étudiants
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold">
                    <tr>
                        <th class="px-6 py-4">Apprenant</th>
                        <th class="px-6 py-4">Email</th>
                        <th class="px-6 py-4">Promotion</th>
                        <th class="px-6 py-4">Spécialisation</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    {% for student in students %}
                    <tr class="hover:bg-slate-50 transition">
                        
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 font-bold">
                                    {{ student.nom|first|upper }}
                                </div>
                                <div>
                                    <p class="font-bold text-slate-700">{{ student.nom|upper }} {{ student.prenom|capitalize }}</p>
                                    <p class="text-xs text-slate-400">ID: #{{ student.id }}</p>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4 text-slate-600">
                            {{ student.email }}
                        </td>

                        <td class="px-6 py-4">
                            <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-xs font-bold border border-blue-100">
                                {{ student.promotion }}
                            </span>
                        </td>

                        <td class="px-6 py-4 text-slate-500 font-medium">
                            {{ student.specialisation }}
                        </td>

                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-slate-400">
                            Aucun apprenant trouvé.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}