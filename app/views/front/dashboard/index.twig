{% extends "layout/layout.twig" %}

{% block content %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord Apprenant - YouCode</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-6">
    
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="glass-card rounded-2xl shadow-2xl p-6 mb-6 text-white">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-3xl font-bold mb-2">
                        <i class="fas fa-user-graduate mr-3"></i>
                        Bienvenue, {{ user.prenom }} {{ user.nom }} !
                    </h1>
                    <p class="text-white/80">Votre espace apprenant YouCode</p>
                    <div class="mt-3 flex items-center text-sm">
                        <i class="fas fa-envelope mr-2"></i>
                        {{ user.email }}
                        <span class="ml-4 px-3 py-1 bg-blue-500/30 rounded-full text-xs">
                            <i class="fas fa-user mr-1"></i> Apprenant
                        </span>
                    </div>
                </div>
                <div class="mt-4 md:mt-0">
                    <a href="/logout" 
                       class="inline-flex items-center px-5 py-3 bg-red-500 hover:bg-red-600 text-white rounded-lg transition">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition">
                <div class="flex items-center">
                    <div class="bg-blue-100 p-4 rounded-xl mr-4">
                        <i class="fas fa-briefcase text-2xl text-blue-600"></i>
                    </div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-800">15</h3>
                        <p class="text-gray-600">Offres disponibles</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition">
                <div class="flex items-center">
                    <div class="bg-green-100 p-4 rounded-xl mr-4">
                        <i class="fas fa-building text-2xl text-green-600"></i>
                    </div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-800">8</h3>
                        <p class="text-gray-600">Entreprises</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition">
                <div class="flex items-center">
                    <div class="bg-purple-100 p-4 rounded-xl mr-4">
                        <i class="fas fa-calendar-check text-2xl text-purple-600"></i>
                    </div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-800">3</h3>
                        <p class="text-gray-600">Entretiens planifiés</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column - Quick Actions -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                        <i class="fas fa-bolt text-yellow-500 mr-3"></i>
                        Actions rapides
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <a href="/offres" 
                           class="group p-5 border border-blue-200 rounded-xl hover:bg-blue-50 transition-all hover:scale-105">
                            <div class="flex items-center">
                                <div class="bg-blue-100 p-3 rounded-lg mr-4">
                                    <i class="fas fa-search text-blue-600"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-800 group-hover:text-blue-600">Rechercher offres</h3>
                                    <p class="text-sm text-gray-600">Trouvez votre stage ou emploi</p>
                                </div>
                            </div>
                        </a>
                        
                        <a href="/profil" 
                           class="group p-5 border border-green-200 rounded-xl hover:bg-green-50 transition-all hover:scale-105">
                            <div class="flex items-center">
                                <div class="bg-green-100 p-3 rounded-lg mr-4">
                                    <i class="fas fa-user-edit text-green-600"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-800 group-hover:text-green-600">Mon profil</h3>
                                    <p class="text-sm text-gray-600">Complétez vos informations</p>
                                </div>
                            </div>
                        </a>
                        
                        <a href="/cv" 
                           class="group p-5 border border-purple-200 rounded-xl hover:bg-purple-50 transition-all hover:scale-105">
                            <div class="flex items-center">
                                <div class="bg-purple-100 p-3 rounded-lg mr-4">
                                    <i class="fas fa-file-alt text-purple-600"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-800 group-hover:text-purple-600">Mon CV</h3>
                                    <p class="text-sm text-gray-600">Téléchargez ou mettez à jour</p>
                                </div>
                            </div>
                        </a>
                        
                        <a href="/entretiens" 
                           class="group p-5 border border-red-200 rounded-xl hover:bg-red-50 transition-all hover:scale-105">
                            <div class="flex items-center">
                                <div class="bg-red-100 p-3 rounded-lg mr-4">
                                    <i class="fas fa-calendar-alt text-red-600"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-800 group-hover:text-red-600">Mes entretiens</h3>
                                    <p class="text-sm text-gray-600">Voir mes rendez-vous</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                
                <!-- Recent Activities -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                        <i class="fas fa-history text-gray-600 mr-3"></i>
                        Activités récentes
                    </h2>
                    
                    <div class="space-y-4">
                        <div class="flex items-center p-3 border-l-4 border-blue-500 bg-blue-50 rounded-r">
                            <i class="fas fa-check-circle text-green-500 mr-3"></i>
                            <div>
                                <p class="font-medium">Candidature envoyée</p>
                                <p class="text-sm text-gray-600">Développeur Web chez TechCorp</p>
                            </div>
                            <span class="ml-auto text-sm text-gray-500">Il y a 2 jours</span>
                        </div>
                        
                        <div class="flex items-center p-3 border-l-4 border-green-500 bg-green-50 rounded-r">
                            <i class="fas fa-calendar-plus text-blue-500 mr-3"></i>
                            <div>
                                <p class="font-medium">Entretien planifié</p>
                                <p class="text-sm text-gray-600">Avec Innovate Solutions</p>
                            </div>
                            <span class="ml-auto text-sm text-gray-500">Demain à 10h</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Right Column - Profile & Notifications -->
            <div>
                <!-- Profile Card -->
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Mon profil</h3>
                    <div class="text-center mb-4">
                        <div class="inline-block p-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full">
                            <i class="fas fa-user text-white text-4xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800 mt-3">{{ user.prenom }} {{ user.nom }}</h4>
                        <p class="text-gray-600 text-sm">Apprenant YouCode</p>
                    </div>
                    
                    <div class="space-y-3">
                        <div class="flex items-center">
                            <i class="fas fa-envelope text-gray-400 mr-3"></i>
                            <span class="text-gray-700">{{ user.email }}</span>
                        </div>
                        <div class="flex items-center">
                            <i class="fas fa-phone text-gray-400 mr-3"></i>
                            <span class="text-gray-700">+212 6 XX XX XX XX</span>
                        </div>
                        <div class="flex items-center">
                            <i class="fas fa-calendar text-gray-400 mr-3"></i>
                            <span class="text-gray-700">Membre depuis Mars 2024</span>
                        </div>
                    </div>
                    
                    <button class="w-full mt-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-lg font-medium hover:opacity-90 transition">
                        <i class="fas fa-edit mr-2"></i> Modifier le profil
                    </button>
                </div>
                
                <!-- Notifications -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-bell text-yellow-500 mr-3"></i>
                        Notifications
                    </h3>
                    
                    <div class="space-y-3">
                        <div class="p-3 bg-yellow-50 rounded-lg">
                            <p class="font-medium text-sm">Nouvelle offre disponible</p>
                            <p class="text-xs text-gray-600">Développeur Full Stack</p>
                        </div>
                        
                        <div class="p-3 bg-blue-50 rounded-lg">
                            <p class="font-medium text-sm">Rappel d'entretien</p>
                            <p class="text-xs text-gray-600">Demain à 14h</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="mt-8 text-center text-white/60 text-sm">
            <p>© 2024 YouCode Job Dating - Plateforme pour apprenants</p>
        </div>
    </div>
    
    <script>
        // Animation pour les cartes
        document.querySelectorAll('.group').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    </script>
</body>
</html>
{% endblock %}