<!-- Modal Candidature -->
<div id="modalCandidature" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full mx-4 max-h-screen overflow-y-auto">
        <!-- Header -->
        <div class="sticky top-0 bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-6 border-b border-slate-200">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold">Soumettre une candidature</h2>
                    <p class="text-blue-100 text-sm mt-1" id="offreTitre"></p>
                </div>
                <button onclick="closeCandidatureModal()" class="p-2 hover:bg-white/20 rounded-lg transition">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
        </div>

        <!-- Content -->
        <form id="formulaireCandidature" method="POST" action="/candidature" enctype="multipart/form-data" class="p-8 space-y-6">
            <input type="hidden" name="annonce_id" id="annonce_id">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <!-- Message de motivation -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">
                    <i class="fas fa-pen-fancy mr-2 text-blue-600"></i>
                    Message de motivation *
                </label>
                <textarea 
                    name="message" 
                    id="message"
                    rows="6" 
                    required
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-slate-400"
                    placeholder="Expliquez pourquoi vous êtes intéressé par ce poste et ce que vous pouvez apporter à l'entreprise...">
                </textarea>
                <p class="text-xs text-slate-500 mt-2">
                    <i class="fas fa-info-circle mr-1"></i>
                    Minimum 50 caractères, maximum 2000 caractères
                </p>
            </div>

            <!-- Boutons -->
            <div class="flex gap-3 pt-4 border-t border-slate-200">
                <button type="button" onclick="closeCandidatureModal()" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold transition">
                    <i class="fas fa-times mr-2"></i>Annuler
                </button>
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:opacity-90 text-white rounded-lg font-semibold transition">
                    <i class="fas fa-send mr-2"></i>Envoyer la candidature
                </button>
            </div>

<script>
function openCandidatureModal(annonceId, titrOffre) {
    document.getElementById('annonce_id').value = annonceId;
    document.getElementById('offreTitre').textContent = titrOffre;
    document.getElementById('modalCandidature').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function closeCandidatureModal() {
    document.getElementById('modalCandidature').classList.add('hidden');
    document.getElementById('formulaireCandidature').reset();
    document.getElementById('fileName').textContent = '';
    document.body.style.overflow = 'auto';
}

// Fermer le modal en cliquant en dehors
document.addEventListener('click', function(e) {
    const modal = document.getElementById('modalCandidature');
    if (e.target === modal) {
        closeCandidatureModal();
    }
});

// Fermer avec Échap
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeCandidatureModal();
    }
});
</script>
