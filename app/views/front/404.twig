{% extends "layout/layout.twig" %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100">
    <div class="text-center">
        <div class="mb-8">
            <h1 class="text-9xl font-bold text-transparent bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text">404</h1>
        </div>
        
        <h2 class="text-4xl font-bold text-slate-800 mb-4">Page non trouvée</h2>
        <p class="text-xl text-slate-600 mb-8">Désolé, la page que vous recherchez n'existe pas ou a été supprimée.</p>
        
        <div class="space-y-4">
            <a href="/" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:opacity-90 text-white rounded-lg font-semibold transition">
                <i class="fas fa-home mr-2"></i>
                Retour à l'accueil
            </a>
        </div>

        <div class="mt-12">
            <i class="fas fa-sad-tear text-6xl text-gray-300"></i>
        </div>
    </div>
</div>
{% endblock %}
