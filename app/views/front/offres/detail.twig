{% extends "front/layout.twig" %}

{% block title %}Détail Annonce - JobDating{% endblock %}

{% block content %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Main Content -->
        <div class="lg:col-span-2">
            <!-- Annonce Header -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
                <div class="h-32 bg-gradient-to-r from-blue-600 to-indigo-600"></div>
                
                <div class="px-8 pb-8 -mt-16">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-slate-800 mb-2">Développeur Web Full Stack</h1>
                            <div class="flex items-center gap-4 text-slate-600">
                                <div class="flex items-center">
                                    <i class="fas fa-building mr-2 text-blue-600"></i>
                                    <span class="font-semibold">TechCorp Solutions</span>
                                </div>
                                <div class="flex items-center">
                                    <i class="fas fa-map-marker-alt mr-2 text-blue-600"></i>
                                    <span>Casablanca</span>
                                </div>
                            </div>
                        </div>
                        <button class="p-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg transition">
                            <i class="fas fa-heart text-2xl"></i>
                        </button>
                    </div>

                    <!-- Stats -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <div class="p-4 bg-blue-50 rounded-lg border border-blue-100">
                            <p class="text-xs font-semibold text-blue-600 uppercase">Type de contrat</p>
                            <p class="text-lg font-bold text-slate-800 mt-1">CDI</p>
                        </div>
                        <div class="p-4 bg-green-50 rounded-lg border border-green-100">
                            <p class="text-xs font-semibold text-green-600 uppercase">Salaire</p>
                            <p class="text-lg font-bold text-slate-800 mt-1">25-35k</p>
                        </div>
                        <div class="p-4 bg-purple-50 rounded-lg border border-purple-100">
                            <p class="text-xs font-semibold text-purple-600 uppercase">Expérience</p>
                            <p class="text-lg font-bold text-slate-800 mt-1">2-3 ans</p>
                        </div>
                        <div class="p-4 bg-orange-50 rounded-lg border border-orange-100">
                            <p class="text-xs font-semibold text-orange-600 uppercase">Publiée</p>
                            <p class="text-lg font-bold text-slate-800 mt-1">5 jours</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 mb-6">
                <h2 class="text-2xl font-bold text-slate-800 mb-4">À propos du poste</h2>
                <div class="text-slate-700 space-y-4">
                    <p>
                        Rejoignez TechCorp Solutions en tant que Développeur Web Full Stack ! Nous recherchons un professionnel talentueux pour rejoindre notre équipe dynamique et contribuer à des projets innovants.
                    </p>
                    <p>
                        Vous travaillerez sur des applications web modernes utilisant les dernières technologies. C'est l'occasion idéale pour développer vos compétences et faire carrière dans un environnement stimulant.
                    </p>
                </div>
            </div>

            <!-- Responsabilités -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 mb-6">
                <h2 class="text-2xl font-bold text-slate-800 mb-4">Responsabilités</h2>
                <ul class="space-y-3 text-slate-700">
                    <li class="flex items-start">
                        <i class="fas fa-check text-green-600 mr-3 mt-1"></i>
                        <span>Développer et maintenir des applications web modernes</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-green-600 mr-3 mt-1"></i>
                        <span>Collaborer avec l'équipe de design et de backend</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-green-600 mr-3 mt-1"></i>
                        <span>Optimiser les performances des applications</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-green-600 mr-3 mt-1"></i>
                        <span>Participer aux code reviews et partager vos connaissances</span>
                    </li>
                </ul>
            </div>

            <!-- Compétences -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8">
                <h2 class="text-2xl font-bold text-slate-800 mb-4">Compétences requises</h2>
                <div class="flex flex-wrap gap-2">
                    {% set skills = ['HTML5', 'CSS3', 'JavaScript', 'React', 'Node.js', 'MySQL', 'PHP', 'Git', 'REST API', 'Responsive Design'] %}
                    {% for skill in skills %}
                        <span class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full font-medium">{{ skill }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- CTA Button -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sticky top-8">
                <button class="w-full py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:opacity-90 text-white rounded-lg font-bold text-lg transition mb-4">
                    <i class="fas fa-paper-plane mr-2"></i>Postuler maintenant
                </button>
                <button class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold transition">
                    <i class="fas fa-heart mr-2"></i>Sauvegarder
                </button>
            </div>

            <!-- Entreprise Info -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="h-20 bg-gradient-to-r from-blue-600 to-indigo-600"></div>
                
                <div class="px-6 pb-6">
                    <div class="flex justify-center -mt-10 mb-4">
                        <img src="https://ui-avatars.com/api/?name=TechCorp" alt="TechCorp" class="w-20 h-20 rounded-full border-4 border-white shadow-md">
                    </div>

                    <h3 class="text-xl font-bold text-center text-slate-800 mb-2">TechCorp Solutions</h3>
                    <p class="text-center text-slate-600 text-sm mb-4">Technologie • Casablanca</p>

                    <div class="space-y-2 text-sm text-slate-600 mb-4">
                        <div class="flex items-center">
                            <i class="fas fa-building w-5 text-blue-600"></i>
                            500+ employés
                        </div>
                        <div class="flex items-center">
                            <i class="fas fa-calendar w-5 text-blue-600"></i>
                            Créée en 2010
                        </div>
                        <div class="flex items-center">
                            <i class="fas fa-globe w-5 text-blue-600"></i>
                            www.techcorp.ma
                        </div>
                    </div>

                    <a href="#" class="block py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg text-sm font-semibold text-center transition">
                        <i class="fas fa-arrow-right mr-1"></i>Voir l'entreprise
                    </a>
                </div>
            </div>

            <!-- Offres similaires -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <h3 class="font-bold text-lg text-slate-800 mb-4">Offres similaires</h3>
                <div class="space-y-3">
                    <a href="#" class="block p-3 border border-slate-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition">
                        <p class="font-semibold text-slate-800">Développeur Frontend</p>
                        <p class="text-xs text-slate-600">TechCorp Solutions</p>
                    </a>
                    <a href="#" class="block p-3 border border-slate-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition">
                        <p class="font-semibold text-slate-800">Développeur Backend</p>
                        <p class="text-xs text-slate-600">Innovate Labs</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
