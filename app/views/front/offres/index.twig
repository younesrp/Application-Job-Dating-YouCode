{% extends "front/layout.twig" %}

{% block title %}Offres d'Emploi - JobDating{% endblock %}

{% block content %}

    <style>
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .annonce-card {
            opacity: 0;
            animation: fadeInUp 0.6s ease-out forwards;
        }
        
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        .animate-header {
            animation: slideInRight 0.8s ease-out;
        }
    </style>

    <!-- Header -->
    <div class="animate-header relative w-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-3xl p-8 mb-10 text-white shadow-xl overflow-hidden">
        <div class="relative z-10">
            <h2 class="text-3xl font-bold mb-2">Offres d'Emploi</h2>
            <p class="text-blue-100">Découvrez {{ pagination.total_items }} opportunités professionnelles</p>
        </div>
        <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
        <div class="absolute bottom-0 right-20 -mb-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
    </div>

    <!-- Messages Flash -->
    {% if flash_success %}
        <div class="bg-green-50 border-l-4 border-green-600 p-4 rounded-lg mb-6 shadow-sm">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-600 mr-3"></i>
                <p class="text-green-700">{{ flash_success }}</p>
            </div>
        </div>
    {% endif %}

    {% if accepted_application %}
    <!-- Alert Message -->
    <div class="bg-green-50 border-l-4 border-green-600 p-6 rounded-lg mb-8 shadow-sm">
        <div class="flex items-start">
            <i class="fas fa-check-circle text-green-600 text-2xl mr-4 mt-1"></i>
            <div>
                <h3 class="text-green-800 font-bold text-lg mb-1">Félicitations! 🎉</h3>
                <p class="text-green-700 mb-2">Vous avez accepté l'offre: <strong>{{ accepted_application.titre }}</strong></p>
                <p class="text-green-600 text-sm">Vous ne pouvez plus postuler à d'autres offres. Concentrez-vous sur cette nouvelle opportunité!</p>
            </div>
        </div>
    </div>
    {% endif %}
    {# recherch mostafa ajax#}
    <div class="mb-6 relative max-w-2xl mx-auto">
        <input 
            type="text" 
            id="searchInput" 
            placeholder="Rechercher par titre ou description..." 
            class="w-full px-4 py-3 pl-10 pr-10 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
        >
        <i class="fas fa-search absolute left-3 top-4 text-slate-400"></i>
        <div id="searchLoader" class="hidden absolute right-3 top-4">
            <i class="fas fa-spinner fa-spin text-blue-600"></i>
        </div>
    </div>
    <!-- Annonces Grid -->
    <div class="space-y-6 results-Mostafa">
        {% if annonces|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for annonce in annonces %}
                    {% set hasApplied = false %}
                    {% for app in my_applications %}
                        {% if app.annonce_id == annonce.id %}
                            {% set hasApplied = true %}
                        {% endif %}
                    {% endfor %}

                    <div class="annonce-card bg-white rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-blue-300 transition overflow-hidden flex flex-col" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        <!-- Header Card -->
                        <div class="card-header px-6 py-5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white">
                            <h3 class="font-bold text-lg mb-2">{{ annonce.titre }}</h3>
                            <p class="text-blue-100 flex items-center">
                                <i class="fas fa-building mr-2"></i>
                                {{ annonce.entreprise_nom }}
                            </p>
                        </div>

                        <!-- Content -->
                        <div class="card-content px-6 py-4 flex-grow">
                            <p class="text-slate-700 text-sm mb-4 line-clamp-3">{{ annonce.description|slice(0, 150) }}...</p>

                            <!-- Tags -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                {% if annonce.type_contrat %}
                                    <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs rounded-full font-medium">
                                        <i class="fas fa-briefcase mr-1"></i>{{ annonce.type_contrat }}
                                    </span>
                                {% endif %}
                                {% if annonce.competences %}
                                    {% set skills = annonce.competences|split(',') %}
                                    {% for skill in skills|slice(0, 2) %}
                                        <span class="px-3 py-1 bg-indigo-100 text-indigo-700 text-xs rounded-full font-medium">
                                            {{ skill|trim }}
                                        </span>
                                    {% endfor %}
                                    {% if skills|length > 2 %}
                                        <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs rounded-full font-medium">
                                            +{{ skills|length - 2 }}
                                        </span>
                                    {% endif %}
                                {% endif %}
                            </div>

                            <p class="text-slate-500 text-xs">
                                <i class="fas fa-calendar mr-1"></i>
                                {{ annonce.date_creation|date('d/m/Y') }}
                            </p>
                        </div>

                        <!-- Footer Actions -->
                        <div class="px-6 py-4 border-t border-slate-100 flex gap-2">
                            <a href="/offres?id={{ annonce.id }}" class="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition text-center">
                                <i class="fas fa-eye mr-1"></i>Détails
                            </a>
                            {% if accepted_application %}
                                <button disabled class="flex-1 py-2 bg-slate-300 text-slate-700 rounded-lg text-sm font-medium cursor-not-allowed" title="Vous avez déjà accepté une offre">
                                    <i class="fas fa-lock mr-1"></i>Bloqué
                                </button>
                            {% elseif hasApplied %}
                                <button disabled class="flex-1 py-2 bg-slate-300 text-slate-700 rounded-lg text-sm font-medium cursor-not-allowed">
                                    <i class="fas fa-check mr-1"></i>Postulé
                                </button>
                            {% else %}
                                <button 
                                    type="button" 
                                    onclick="openCandidatureModal('{{ annonce.id }}', '{{ annonce.titre|escape('js') }}')"
                                    class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition">
                                    <i class="fas fa-send mr-1"></i>Postuler
                                </button>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Pagination -->
            {% if pagination.total_pages > 1 %}
            <div class="flex items-center justify-center gap-2 mt-12 pb-8">
                <!-- Bouton Précédent -->
                {% if pagination.has_previous %}
                    <a href="/offres?page=1" class="px-3 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition" title="Première page">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <a href="/offres?page={{ pagination.previous_page }}" class="px-3 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition">
                        Précédent
                    </a>
                {% else %}
                    <button disabled class="px-3 py-2 bg-slate-100 text-slate-400 rounded-lg cursor-not-allowed">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button disabled class="px-3 py-2 bg-slate-100 text-slate-400 rounded-lg cursor-not-allowed">
                        Précédent
                    </button>
                {% endif %}

                <!-- Numéros de pages -->
                <div class="flex items-center gap-1">
                    {% for pageNum in 1..pagination.total_pages %}
                        {% if pageNum == pagination.current_page %}
                            <span class="px-3 py-2 bg-blue-600 text-white rounded-lg font-semibold">
                                {{ pageNum }}
                            </span>
                        {% else %}
                            <a href="/offres?page={{ pageNum }}" class="px-3 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition">
                                {{ pageNum }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>

                <!-- Bouton Suivant -->
                {% if pagination.has_next %}
                    <a href="/offres?page={{ pagination.next_page }}" class="px-3 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition">
                        Suivant
                    </a>
                    <a href="/offres?page={{ pagination.total_pages }}" class="px-3 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition" title="Dernière page">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                {% else %}
                    <button disabled class="px-3 py-2 bg-slate-100 text-slate-400 rounded-lg cursor-not-allowed">
                        Suivant
                    </button>
                    <button disabled class="px-3 py-2 bg-slate-100 text-slate-400 rounded-lg cursor-not-allowed">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                {% endif %}
            </div>

            <!-- Info Pagination -->
            <div class="text-center text-slate-600 text-sm pb-4">
                Page <strong>{{ pagination.current_page }}</strong> sur <strong>{{ pagination.total_pages }}</strong> 
                — <strong>{{ pagination.total_items }}</strong> annonces
            </div>
            {% endif %}

        {% else %}
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center">
                <i class="fas fa-inbox text-6xl text-slate-300 mb-4"></i>
                <p class="text-slate-600 font-medium text-lg mb-2">Aucune annonce disponible</p>
                <p class="text-slate-500">Revenez plus tard pour découvrir de nouvelles opportunités</p>
            </div>
        {% endif %}
    </div>

    <!-- Include Modal -->
    {% include "front/dashboard/modal-candidature.twig" %}

    <script>
    let searchTimeout;
    const searchInput = document.getElementById('searchInput');
    const searchLoader = document.getElementById('searchLoader');
    const annonceCards = document.querySelectorAll('.results-Mostafa .grid > div');

    // Store original annonces data
    const annoncesData = [];
    annonceCards.forEach((card, index) => {
        const titre = card.querySelector('h3')?.textContent || '';
        const description = card.querySelector('.line-clamp-3')?.textContent || '';
        annoncesData.push({ element: card, titre, description, index });
    });

    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim().toLowerCase();
        
        // If empty, show all
        if (query.length === 0) {
            annoncesData.forEach(data => {
                data.element.style.display = '';
                const header = data.element.querySelector('.card-header');
                const content = data.element.querySelector('.card-content');
                if (header) {
                    header.className = 'card-header px-6 py-5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white';
                }
                if (content) {
                    content.classList.remove('!bg-green-50');
                }
                resetHighlight(data.element);
            });
            return;
        }
        
        if (query.length < 2) return;
        
        searchLoader.classList.remove('hidden');
        
        searchTimeout = setTimeout(() => {
            searchLoader.classList.add('hidden');
            
            annoncesData.forEach(data => {
                const titreMatch = data.titre.toLowerCase().includes(query);
                const descMatch = data.description.toLowerCase().includes(query);
                
                const header = data.element.querySelector('.card-header');
                const content = data.element.querySelector('.card-content');
                
                // Reset
                if (header) {
                    header.className = 'card-header px-6 py-5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white';
                }
                if (content) {
                    content.classList.remove('!bg-green-50');
                }
                resetHighlight(data.element);
                
                if (titreMatch || descMatch) {
                    // Show with green header
                    data.element.style.display = '';
                    if (header) {
                        header.className = 'card-header px-6 py-5 bg-gradient-to-r from-green-400 to-green-600 text-white';
                    }
                    if (content) {
                        content.classList.add('!bg-green-50');
                    }
                    
                    // Highlight text
                    if (titreMatch) {
                        highlightText(data.element.querySelector('h3'), query);
                    }
                    if (descMatch) {
                        highlightText(data.element.querySelector('.line-clamp-3'), query);
                    }
                } else {
                    // Hide non-matches
                    data.element.style.display = 'none';
                }
            });
        }, 300);
    });

    function highlightText(element, query) {
        if (!element) return;
        const originalText = element.getAttribute('data-original') || element.textContent;
        if (!element.getAttribute('data-original')) {
            element.setAttribute('data-original', originalText);
        }
        
        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
        const highlighted = originalText.replace(regex, '<mark class="bg-yellow-300 text-slate-900 px-1 rounded font-bold">$1</mark>');
        element.innerHTML = highlighted;
    }

    function resetHighlight(card) {
        const elements = card.querySelectorAll('[data-original]');
        elements.forEach(el => {
            el.textContent = el.getAttribute('data-original');
        });
    }
    
    function escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }
    </script>

{% endblock %}
