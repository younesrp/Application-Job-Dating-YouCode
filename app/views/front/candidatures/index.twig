{% extends "front/layout.twig" %}

{% block title %}Mes Candidatures - JobDating{% endblock %}

{% block content %}

    <!-- Header -->
    <div class="relative w-full bg-gradient-to-r from-green-600 to-emerald-600 rounded-3xl p-8 mb-10 text-white shadow-xl overflow-hidden">
        <div class="relative z-10">
            <h2 class="text-3xl font-bold mb-2">Mes Candidatures 📋</h2>
            <p class="text-green-100">Suivi complet de vos candidatures</p>
        </div>
        <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
        <div class="absolute bottom-0 right-20 -mb-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">{{ my_applications|length }}</h3>
                </div>
                <div class="p-3 bg-blue-50 rounded-xl text-blue-600">
                    <i class="fas fa-list text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">En Attente</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">
                        {% set pending = my_applications|filter(app => app.statut == 'en_attente')|length %}
                        {{ pending }}
                    </h3>
                </div>
                <div class="p-3 bg-yellow-50 rounded-xl text-yellow-600">
                    <i class="fas fa-hourglass-half text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Validées</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">
                        {% set accepted = my_applications|filter(app => app.statut == 'validee')|length %}
                        {{ accepted }}
                    </h3>
                </div>
                <div class="p-3 bg-green-50 rounded-xl text-green-600">
                    <i class="fas fa-check-circle text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Refusées</p>
                    <h3 class="text-3xl font-bold text-slate-800 mt-2">
                        {% set rejected = my_applications|filter(app => app.statut == 'refusee')|length %}
                        {{ rejected }}
                    </h3>
                </div>
                <div class="p-3 bg-red-50 rounded-xl text-red-600">
                    <i class="fas fa-times-circle text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Candidatures List -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 bg-gradient-to-r from-green-600 to-emerald-600 text-white">
            <h3 class="font-bold text-lg">Liste de vos candidatures</h3>
        </div>

        <div class="p-6">
            {% if my_applications|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-slate-200">
                                <th class="text-left py-3 px-4 font-semibold text-slate-700">Poste</th>
                                <th class="text-left py-3 px-4 font-semibold text-slate-700">Entreprise</th>
                                <th class="text-left py-3 px-4 font-semibold text-slate-700">Date</th>
                                <th class="text-center py-3 px-4 font-semibold text-slate-700">Statut</th>
                                <th class="text-center py-3 px-4 font-semibold text-slate-700">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for app in my_applications %}
                                <tr class="border-b border-slate-100 hover:bg-slate-50 transition">
                                    <td class="py-4 px-4">
                                        <p class="font-semibold text-slate-800">{{ app.annonce_titre }}</p>
                                        <p class="text-xs text-slate-500 mt-1">ID: {{ app.id }}</p>
                                    </td>
                                    <td class="py-4 px-4">
                                        <div class="flex items-center">
                                            <div class="p-2 bg-blue-50 rounded-lg mr-3">
                                                <i class="fas fa-building text-blue-600"></i>
                                            </div>
                                            <span class="font-medium text-slate-700">{{ app.entreprise_nom }}</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="text-slate-600">{{ app.date_candidature|date('d/m/Y') }}</span>
                                        <p class="text-xs text-slate-500">{{ app.date_candidature|date('H:i') }}</p>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold 
                                            {% if app.statut == 'validee' %}
                                                bg-green-100 text-green-700
                                            {% elseif app.statut == 'refusee' %}
                                                bg-red-100 text-red-700
                                            {% else %}
                                                bg-yellow-100 text-yellow-700
                                            {% endif %}">
                                            <i class="fas mr-1
                                                {% if app.statut == 'validee' %}
                                                    fa-check-circle
                                                {% elseif app.statut == 'refusee' %}
                                                    fa-times-circle
                                                {% else %}
                                                    fa-hourglass-half
                                                {% endif %}
                                            "></i>
                                            {{ app.statut|capitalize }}
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <button class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition">
                                            <i class="fas fa-eye mr-1"></i>Détails
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-12">
                    <i class="fas fa-inbox text-5xl text-slate-300 mb-4"></i>
                    <p class="text-slate-600 font-medium">Aucune candidature</p>
                    <p class="text-slate-500 text-sm mb-4">Vous n'avez pas encore postulé à une offre</p>
                    <a href="/dashboard" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">
                        <i class="fas fa-briefcase mr-2"></i>Voir les offres
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

{% endblock %}
